# Скопируйте этот файл в `.env` и заполните своими значениями.
# `docker compose up -d` автоматически подхватит .env.

# Мастер-пароль для модального окна "Загрузить модель".
# ОБЯЗАТЕЛЬНО смените на production!
ADMIN_PASSWORD=admin123

# Внешний порт виртуальной машины. Контейнер всегда слушает 8080 внутри.
# Если поставите 80, сайт будет доступен по http://<ip-виртуалки>/
HOST_PORT=8080

# (Опционально) Полный публичный URL, если перед контейнером стоит
# nginx / cloudflare и нужно фиксированное значение для серверного QR API.
# Пример: https://college.example.ru
PUBLIC_BASE_URL=
