# Скопируйте файл в `.env` перед запуском через Docker Compose.

# Порт на хосте. Внутри контейнера приложение всегда слушает 8080.
HOST_PORT=8080

# Пароль для модального окна "Загрузить модель".
# Для production обязательно замените.
ADMIN_PASSWORD=admin123

# Более безопасный вариант для production: bcrypt-хэш пароля.
# Если задан ADMIN_PASSWORD_HASH, он имеет приоритет над ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=

# Внешний адрес сайта для QR-кодов (обязательно для телефона при доступе через localhost/Docker).
# Укажите IP ПК в Wi‑Fi или домен колледжа. Пример: http://192.168.0.42:8080
# Пример за nginx: https://college.example.ru
PUBLIC_BASE_URL=
